+def approved_media(article: dict) -> str:
+    media = article.get("media")
+    if media is None:
+        return ""
+    kind = media.get("kind")
+    if kind in {"video", "reels", "infographic"}:
+        src = media.get("path", "")
+        pattern = r"assets/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\.(?:png|webp|jpg)" if kind == "infographic" else r"assets/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\.mp4"
+        target = SITE / src
+        if not re.fullmatch(pattern, src) or not target.is_file() or SITE.resolve() not in target.resolve().parents:
+            raise EditorialError("Медиафайл не найден в каталоге журнала.")
+        digest = sha256()
+        with target.open("rb") as stream:
+            for chunk in iter(lambda: stream.read(65536), b""):
+                digest.update(chunk)
+        if digest.hexdigest() != media.get("sha256"):
+            raise EditorialError("Медиафайл отличается от утверждённой версии.")
+        label = media.get("label", "").strip()
+        if not label:
+            raise EditorialError("Нужно текстовое описание материала.")
+        if kind == "infographic":
+            return f'<figure><img src="../{src}" alt="{html.escape(label)}"></figure>'
+        return f'<figure><video controls playsinline preload="metadata" src="../{src}" aria-label="{html.escape(label)}"></video><figcaption>{html.escape(label)}</figcaption></figure>'
+    if kind == "carousel":
+        slides = media.get("slides")
+        if not isinstance(slides, list) or not 2 <= len(slides) <= 12 or not all(
+            isinstance(slide, str) and 1 <= len(slide.strip()) <= 500 for slide in slides
+        ):
+            raise EditorialError("Нужно от двух до двенадцати текстовых карточек.")
+        return '<ol class="slides">' + "".join(f"<li>{html.escape(slide)}</li>" for slide in slides) + "</ol>"
+    raise EditorialError("Неизвестный формат медиа.")
+
+
